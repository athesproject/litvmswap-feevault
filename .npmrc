# Supply-chain hardening (LitVM team audit ATH-06): official registry only, no install scripts, exact versions.
registry=https://registry.npmjs.org/
ignore-scripts=true
save-exact=true
package-lock=true
audit=true
fund=false
# Install peer dependencies even where a machine-wide npm config turns that off, so the lockfile is complete.
legacy-peer-deps=false
strict-peer-deps=true
